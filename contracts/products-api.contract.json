{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "stock": {
            "type": "number",
            "minimum": 0
          },
          "brand": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string",
            "format": "uri"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "category",
          "price",
          "rating",
          "stock",
          "thumbnail"
        ],
        "additionalProperties": {}
      }
    },
    "total": {
      "type": "number",
      "minimum": 0
    },
    "skip": {
      "type": "number",
      "minimum": 0
    },
    "limit": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": ["products", "total", "skip", "limit"],
  "additionalProperties": false
}
